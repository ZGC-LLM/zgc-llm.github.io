# ── 构建时烘焙（build-time）──────────────────────────────────────────
# 以下 NEXT_PUBLIC_* 在 `pnpm build` 时烘焙进产物（client/static 输出），
# 影响 canonical、sitemap、飞书问卷链接。改动后必须 `--build` 重建，改 .env 不重建无效。

# 站点对外完整 URL（含协议）。烘焙进 canonical/sitemap。
# 本地开发默认 http://localhost:3000；自托管请填你自己的 https 域名，
# 且域名部分应与下方运行时 SITE_DOMAIN 一致（如 https://example.com ↔ example.com）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 统一合作/加入申请入口（飞书问卷外链，https，外部可填）。
# 可选：留空则使用 src/config/site.ts 内置的默认联盟问卷链接；填写则覆盖默认值。
NEXT_PUBLIC_APPLICATION_URL=

# 网络安全工作组专属飞书问卷（https 外链，外部可填）。
# 可选：留空则使用内置的网安工作组默认问卷链接（未命中则回退通用入口）；填写则覆盖默认值。
NEXT_PUBLIC_APPLICATION_URL_CYBERSECURITY=

# 网络安全人才培养计划专属飞书问卷（https 外链，外部可填）。
# 可选：留空则回退到内置默认/通用入口；填写则覆盖默认值。
NEXT_PUBLIC_APPLICATION_URL_CYBERSECURITY_PROGRAM=

# ── 运行时（runtime）─────────────────────────────────────────────────
# 以下变量仅 docker-compose.caddy.yml（自托管 + 自动 HTTPS 编排）使用。
# 改动无需重建 web 镜像，重启 caddy 服务即可生效。

# 对外服务域名（不含协议）。Caddy 据此自动向 Let's Encrypt 签发 HTTPS 证书。
# 必填（使用 docker-compose.caddy.yml 时）：须已解析到本机，且放行 80/443。
SITE_DOMAIN=example.com

# ACME/Let's Encrypt 账户邮箱，用于证书到期/异常通知。
# 必填（使用 docker-compose.caddy.yml 时）。
ACME_EMAIL=admin@example.com

# 可选：Caddy 全局额外指令。测试环境（域名未指向本机、无法走公网 ACME）设为
# local_certs 用内部自签 CA；生产部署留空以走公网 Let's Encrypt 签发。
CADDY_EXTRA_GLOBAL=
